# ---------- Database ----------
# Bỏ trống = dùng PGlite (Postgres nhúng, lưu ở .data/pglite) – tiện khi dev, không cần cài gì.
# Production: chuỗi kết nối Postgres, vd postgres://sandeal:matkhau@db:5432/sandeal
DATABASE_URL=""

# ---------- Docker / VPS (chỉ dùng với docker compose) ----------
DOMAIN=""
POSTGRES_PASSWORD=""

# ---------- Chung ----------
SITE_URL="http://localhost:3000"
# Chuỗi ngẫu nhiên dài (openssl rand -base64 32) – BẮT BUỘC khi production
AUTH_SECRET=""
# Email được vào trang /admin (cách nhau bởi dấu phẩy)
ADMIN_EMAILS=""

# ---------- Nguồn dữ liệu ----------
# mock | shopee | lazada | tiktok | accesstrade (cách nhau bởi dấu phẩy)
SOURCES="mock"

# Shopee Affiliate Open API (https://affiliate.shopee.vn)
SHOPEE_APP_ID=""
SHOPEE_SECRET=""
SHOPEE_ENDPOINT="https://open-api.affiliate.shopee.vn/graphql"
SHOPEE_KEYWORDS="tai nghe,sữa rửa mặt,nồi chiên không dầu,balo"

# Lazada Open Platform – Affiliate (https://open.lazada.com)
LAZADA_APP_KEY=""
LAZADA_APP_SECRET=""
LAZADA_USER_TOKEN=""
LAZADA_ACCESS_TOKEN=""
LAZADA_GATEWAY="https://api.lazada.vn/rest"
LAZADA_FEED_PATH="/marketing/product/feed"
LAZADA_OFFER_TYPE="1"

# TikTok Shop Partner – Affiliate Creator API (https://partner.tiktokshop.com)
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""
TIKTOK_ACCESS_TOKEN=""
TIKTOK_KEYWORDS=""

# AccessTrade Publisher API (https://developers.accesstrade.vn)
ACCESSTRADE_TOKEN=""
ACCESSTRADE_MERCHANTS="shopee,lazada,tiktokshop"

# ---------- Lịch đồng bộ ----------
SYNC_CRON="0 */2 * * *"
# 1 = chạy đồng bộ ngay khi khởi động web
SYNC_ON_START="0"
# Để trống: tự chạy lịch trong web khi dùng PGlite, không chạy khi dùng Postgres (dùng `npm run worker`)
RUN_WORKER_IN_WEB=""

# ---------- Bản tin theo sở thích & nhắc sale (giờ Việt Nam) ----------
DIGEST_HOUR="8"
SALE_REMINDER_HOUR="20"

# ---------- Email ----------
# Bỏ trống = in email ra console (link đăng nhập hiện trong terminal)
SMTP_URL=""
MAIL_FROM="Săn Deal <no-reply@example.com>"

# ---------- Thông báo đẩy (Web Push) ----------
# Tạo khoá: npm run vapid  rồi dán 2 dòng vào đây
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# ---------- Đăng deal lên mạng xã hội (giờ Việt Nam) ----------
SOCIAL_HOURS="11,20"
SOCIAL_PER_RUN="3"
SOCIAL_MIN_SCORE="50"
# Trang Facebook: ID trang + Page Access Token (quyền pages_manage_posts)
FB_PAGE_ID=""
FB_PAGE_TOKEN=""

# ---------- Telegram (đăng deal hot lên kênh) ----------
TELEGRAM_BOT_TOKEN=""
# Tên bot (không có @) để người dùng kết nối Telegram cá nhân nhận bản tin
TELEGRAM_BOT_USERNAME=""
TELEGRAM_CHAT_ID=""

# ---------- Khoá cả site bằng mật khẩu (HTTP Basic Auth) ----------
# Điền cả 2 để bắt người xem nhập tên + mật khẩu (khi site đang chạy thử). Để trống = công khai.
# /api/ext/* (tiện ích trình duyệt) luôn mở.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""
