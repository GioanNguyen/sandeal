# ---------- Database ----------
# Bỏ trống = dùng PGlite (Postgres nhúng, lưu ở .data/pglite) – tiện khi dev, không cần cài gì.
# Production: chuỗi kết nối Postgres, vd postgres://sandeal:matkhau@db:5432/sandeal
DATABASE_URL=""

# ---------- Docker / VPS (chỉ dùng với docker compose) ----------
DOMAIN=""
POSTGRES_PASSWORD=""

# ---------- Chung ----------
SITE_URL="http://localhost:3000"
# Chuỗi ngẫu nhiên dài (openssl rand -base64 32) – BẮT BUỘC khi production
AUTH_SECRET=""
# Email được vào trang /admin (cách nhau bởi dấu phẩy)
ADMIN_EMAILS=""

# ---------- Nguồn dữ liệu ----------
# mock | shopee | lazada | tiktok | accesstrade (cách nhau bởi dấu phẩy)
# "none" = không đồng bộ nguồn nào (chỉ nhập CSV Shopee trong /admin). Để trống = mock.
SOURCES="mock"
# Món không còn trong kết quả của sàn quá số ngày này (so với lần đồng bộ mới nhất của sàn đó) -> ẩn khỏi danh sách deal,
# trang sản phẩm vẫn giữ và mời "Báo khi có lại"
PRODUCT_STALE_DAYS="3"
# Giá do người dùng tiện ích góp (khi xem trang sản phẩm): cũ hơn số ngày này thì không đưa vào danh sách deal
EXT_FRESH_DAYS="7"
# Dữ liệu mẫu khi dán link: 1 = bật cả trên production; 0 = tắt cả khi dev (để thử góp giá từ tiện ích)
MOCK_LOOKUP=""

# Shopee Affiliate Open API (https://affiliate.shopee.vn)
SHOPEE_APP_ID=""
SHOPEE_SECRET=""
SHOPEE_ENDPOINT="https://open-api.affiliate.shopee.vn/graphql"
SHOPEE_KEYWORDS="tai nghe,sữa rửa mặt,nồi chiên không dầu,balo"

# Lazada Open Platform – Affiliate (https://open.lazada.com)
LAZADA_APP_KEY=""
LAZADA_APP_SECRET=""
LAZADA_USER_TOKEN=""
LAZADA_ACCESS_TOKEN=""
LAZADA_GATEWAY="https://api.lazada.vn/rest"
LAZADA_FEED_PATH="/marketing/product/feed"
LAZADA_OFFER_TYPE="1"

# TikTok Shop Partner – Affiliate Creator API (https://partner.tiktokshop.com)
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""
TIKTOK_ACCESS_TOKEN=""
TIKTOK_KEYWORDS=""

# AccessTrade Publisher API (https://developers.accesstrade.vn)
ACCESSTRADE_TOKEN=""
ACCESSTRADE_MERCHANTS="shopee,lazada,tiktokshop"

# ---------- Tìm bằng ảnh (/tim-bang-anh) ----------
# Nhận diện ảnh bằng mô hình CLIP chạy ngay trên máy chủ (không gửi ảnh ra ngoài). Lần đầu tự tải mô hình ~90 MB
# từ huggingface.co, cần thêm ~400 MB RAM khi dùng. 0 = tắt.
IMAGE_SEARCH="1"
# Nơi lưu mô hình đã tải (VPS/Docker đã đặt sẵn /opt/sandeal/models, /models)
# IMAGE_MODEL_DIR=".data/models"
# IMAGE_MODEL="Xenova/clip-vit-base-patch32"
# IMAGE_MODEL_DTYPE="q8"              # q8 (nhẹ) | fp32 (chính xác hơn chút, nặng gấp 4)
# IMAGE_MODEL_HOST=""                 # máy chủ thay huggingface.co (mirror) nếu VPS không vào được
# IMAGE_MODEL_LOCAL_DIR=""            # đọc mô hình từ thư mục có sẵn, không tải mạng
# Ngưỡng độ giống (0–1): dưới MIN không hiện; từ VERY là "Rất giống", từ SAME là "Giống hệt"
# IMAGE_SIM_MIN="0.72"
# IMAGE_SIM_VERY="0.85"
# IMAGE_SIM_SAME="0.93"
# Số món nhận diện ảnh mỗi đợt (mỗi 20 phút)
# IMAGE_INDEX_BATCH="300"

# ---------- Tóm tắt đánh giá bằng AI (tuỳ chọn) ----------
# Có khoá Claude API thì worker viết tóm tắt đánh giá cho món có ≥ 8 đánh giá (mỗi giờ, chỉ món có thêm đủ đánh giá mới).
# Để trống: trang sản phẩm vẫn có tóm tắt theo khía cạnh và cảnh báo rủi ro, không cần AI.
ANTHROPIC_API_KEY=""
# REVIEW_AI_MODEL="claude-haiku-4-5-20251001"
# REVIEW_AI_PER_RUN="20"

# ---------- Reels Facebook tự động (video dọc ~13 giây) ----------
# Cần ffmpeg trên máy chủ (install.sh và Docker tự cài) + FB_PAGE_ID, FB_PAGE_TOKEN như đăng bài. 0 = tắt.
REELS="1"
# Giờ đăng (giờ Việt Nam, đăng lúc hh:05) và giờ dựng sẵn video lúc vắng khách (hh:20)
REELS_HOURS="12,21"
REELS_PREPARE_HOUR="5"
# Nhạc nền: mặc định lấy ngẫu nhiên trong src/assets/music (nhạc để trong code, đi theo git). Thư mục trống = không nhạc.
# Muốn để nhạc chỗ khác trên VPS thì đặt đường dẫn ở đây. Chỉ dùng nhạc miễn phí bản quyền.
# REELS_MUSIC_DIR="/opt/sandeal/music"
# Độ to nhạc nền: mỗi bài được đo rồi tự chỉnh về cùng mức này (LUFS, -16 vừa nghe trên điện thoại; -14 to hơn)
# REELS_MUSIC_LUFS="-16"
# VPS yếu: 1280 = video 720×1280 (nhẹ khoảng một nửa); mặc định 1080×1920
# REELS_HEIGHT="1920"
# Nơi lấy khung hình (mặc định http://127.0.0.1:PORT; Docker đã đặt http://web:3000)
# REELS_RENDER_URL=""

# ---------- Bài hướng dẫn & tốc độ trang ----------
# Bài hướng dẫn theo lịch (src/lib/guides-lich.tsx) tự hiện lúc 8h ngày đăng và tự đăng link lên Trang Facebook.
# GUIDES_FB=0 để không tự đăng lên Facebook (bài vẫn hiện trên site)
# GUIDES_FB="1"
# Lịch bài viết sẵn hết thì AI (Claude) tự soạn bài nháp từ số liệu thật mỗi thứ Hai và email ADMIN_EMAILS để duyệt
# (cần ANTHROPIC_API_KEY, khoảng 1.000đ mỗi bài). Bài chỉ đăng khi bạn bấm Duyệt ở /admin/huong-dan.
# GUIDES_AI=0 để tắt · GUIDES_AI_MODEL đổi model · GUIDES_AI_AUTO=1: bài nháp không ai duyệt sau 3 ngày thì tự duyệt
# GUIDES_AI="1"
# GUIDES_AI_MODEL="claude-sonnet-5-5"
# GUIDES_AI_AUTO="0"
# Đo tốc độ tải trang trên máy khách thật (xem ở /admin/toc-do). VITALS=0 để tắt; VITALS_SAMPLE=0.5 chỉ đo 50% lượt xem
# VITALS="1"
# VITALS_SAMPLE="1"
# Báo Bing, Yandex, Naver… có trang mới/đổi (IndexNow) sau mỗi lần đồng bộ giá. Google không dùng IndexNow:
# khai báo /sitemap.xml 1 lần trong Google Search Console. INDEXNOW=0 để tắt; INDEXNOW_KEY tuỳ chọn (mặc định tự sinh)
# INDEXNOW="1"
# INDEXNOW_KEY=""

# ---------- Làm đầy dữ liệu sản phẩm ----------
# Tự xếp danh mục cho món chưa có (theo từ khoá trong tên; món khó dùng AI nếu có ANTHROPIC_API_KEY), mỗi giờ phút 25.
# AUTOCAT=0 để tắt · AUTOCAT_AI=0 để không dùng AI · AUTOCAT_AI_PER_RUN số món hỏi AI mỗi lần (mặc định 200)
# AUTOCAT="1"
# AUTOCAT_AI="1"
# Tự lấy ảnh cho món thiếu ảnh qua Shopee Affiliate Open API (cần SHOPEE_APP_ID, SHOPEE_SECRET), mỗi giờ phút 50.
# IMAGE_FILL=0 để tắt · IMAGE_FILL_PER_RUN (mặc định 100)
# IMAGE_FILL="1"

# ---------- Lịch đồng bộ ----------
SYNC_CRON="0 */2 * * *"
# 1 = chạy đồng bộ ngay khi khởi động web
SYNC_ON_START="0"
# Để trống: tự chạy lịch trong web khi dùng PGlite, không chạy khi dùng Postgres (dùng `npm run worker`)
RUN_WORKER_IN_WEB=""

# ---------- Bản tin theo sở thích & nhắc sale (giờ Việt Nam) ----------
DIGEST_HOUR="8"
SALE_REMINDER_HOUR="20"

# ---------- Email ----------
# Bỏ trống = in email ra console (link đăng nhập hiện trong terminal)
SMTP_URL=""
MAIL_FROM="Săn Deal <no-reply@example.com>"
# Email liên hệ hiện trên trang Chính sách bảo mật / Điều khoản (nhận yêu cầu xoá dữ liệu). Bỏ trống = email đầu tiên trong ADMIN_EMAILS
CONTACT_EMAIL=""

# ---------- Thông báo đẩy (Web Push) ----------
# Tạo khoá: npm run vapid  rồi dán 2 dòng vào đây
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# ---------- Đăng deal lên mạng xã hội (giờ Việt Nam) ----------
SOCIAL_HOURS="11,20"
SOCIAL_PER_RUN="3"
# Giờ đăng lệch ngẫu nhiên 0…N phút mỗi lần (bài deal, Reels, bài hướng dẫn) để Trang không đăng đúng một phút mỗi ngày.
# Mặc định 20 (11h → 11h00–11h20), tối đa 45, 0 = đăng đúng giờ
# POST_JITTER_MIN="20"
# Bài "Bóc giá ảo" tự đăng lên Trang (3 món ghi giảm sâu nhưng giá như mọi ngày, trang /giam-gia-ao); sắp tới sale lớn thì
# thay bằng bài "Ai nâng giá trước sale?". GIA_AO=0 để tắt · ngày trong tuần 0 = CN … 6 = thứ 7 · giờ Việt Nam
# GIA_AO="1"
# GIA_AO_DAYS="3,6"
# GIA_AO_HOUR="9"
SOCIAL_MIN_SCORE="50"
# Trang Facebook: ID trang + Page Access Token (quyền pages_manage_posts, pages_manage_engagement)
FB_PAGE_ID=""
FB_PAGE_TOKEN=""
# "digest" (mặc định): mỗi lượt 1 bài tổng hợp SOCIAL_PER_RUN deal · "single": mỗi deal 1 bài
FB_POST_STYLE="digest"
# "1" (mặc định): bài ảnh, thân bài không link, web tự đăng bình luận đầu chứa link (cần quyền pages_manage_engagement)
# "0": kiểu cũ – link nằm trong bài
FB_LINK_IN_COMMENT="1"
# "1" = bài đăng TỰ ĐỘNG (giờ vàng) đăng kèm Story ảnh dọc 9:16. Trang Đăng bài có ô "Đăng kèm Story" riêng.
# Story qua API không gắn được link bấm: ảnh ghi "link ở bài viết mới nhất" + link ngắn.
FB_STORY="0"
# Không đăng lại cùng 1 món lên cùng kênh trong N ngày (tự động bỏ qua; trang Đăng bài cảnh báo, bấm "Vẫn đăng" để bỏ qua)
SOCIAL_REPOST_DAYS="7"
# (Không bắt buộc) App ID của ứng dụng Meta – thêm thẻ fb:app_id để xem thống kê chia sẻ, hết cảnh báo trong Sharing Debugger
FB_APP_ID=""
# Tên hiển thị trong bài tổng hợp: "Hôm nay, <tên> giới thiệu…"
FB_PAGE_NAME="Săn Deal"
# Nút "Theo dõi Trang Facebook" / "Vào nhóm săn deal" trên web (trang sản phẩm, chân trang, bài hướng dẫn).
# Bỏ trống FB_PAGE_URL thì dùng https://www.facebook.com/<FB_PAGE_ID>; không có nhóm thì để trống FB_GROUP_URL.
# Có ZALO_OA_ID thì hiện thêm nút Zalo; TELEGRAM_CHAT_ID dạng @ten_kenh thì hiện thêm nút kênh Telegram.
FB_PAGE_URL=""
FB_GROUP_URL=""

# ---------- Telegram (đăng deal hot lên kênh) ----------
TELEGRAM_BOT_TOKEN=""
# Tên bot (không có @) để người dùng kết nối Telegram cá nhân nhận bản tin
TELEGRAM_BOT_USERNAME=""
TELEGRAM_CHAT_ID=""

# ---------- Khoá cả site bằng mật khẩu (HTTP Basic Auth) ----------
# Điền cả 2 để bắt người xem nhập tên + mật khẩu (khi site đang chạy thử). Để trống = công khai.
# /api/ext/* (tiện ích trình duyệt) luôn mở.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""

# ---------- Zalo OA: báo giá qua Zalo (xem docs/zalo-oa.md) ----------
ZALO_APP_ID=""
ZALO_APP_SECRET=""
# ID của OA (số trong link zalo.me/<ID>)
ZALO_OA_ID=""
# Refresh token lần đầu (lấy khi cấp quyền OA cho ứng dụng); các lần sau web tự lưu token mới vào database
ZALO_REFRESH_TOKEN=""
# "OA Secret Key" trong phần Webhook – dùng để kiểm tra chữ ký sự kiện Zalo gửi tới
ZALO_WEBHOOK_SECRET=""
# Mã xác thực tên miền (thẻ meta zalo-platform-site-verification)
ZALO_VERIFY_META=""

# --- Google Search Console (tuỳ chọn – Quản trị › Nhu cầu: từ khoá Google đưa khách tới, từ khoá sắp lên top) ---
# Tài khoản dịch vụ chỉ đọc: tạo trong Google Cloud (bật Search Console API), thêm email của nó vào Search Console (quyền Bị hạn chế)
# GSC_SITE=sc-domain:sandealgiare.com
# GSC_CLIENT_EMAIL=san-deal@du-an.iam.gserviceaccount.com
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
