# SQLite khi chạy thử; production đổi sang Postgres (xem README)
DATABASE_URL="file:./dev.db"

# Nguồn dữ liệu bật: mock | shopee | accesstrade (cách nhau bởi dấu phẩy)
SOURCES="mock"

# Shopee Affiliate Open API (https://affiliate.shopee.vn)
SHOPEE_APP_ID=""
SHOPEE_SECRET=""
SHOPEE_ENDPOINT="https://open-api.affiliate.shopee.vn/graphql"
# Từ khoá cần quét, cách nhau bởi dấu phẩy
SHOPEE_KEYWORDS="tai nghe,sữa rửa mặt,nồi chiên không dầu,balo"

# AccessTrade Publisher API (https://developers.accesstrade.vn)
ACCESSTRADE_TOKEN=""
ACCESSTRADE_MERCHANTS="shopee,lazada,tiktokshop"

# Lịch đồng bộ (cron) cho worker
SYNC_CRON="0 */2 * * *"

# Email cảnh báo giá (bỏ trống = chỉ in ra console)
SMTP_URL=""
MAIL_FROM="San Deal <no-reply@example.com>"
SITE_URL="http://localhost:3000"
